# Copia este archivo a .env.local y rellena los valores reales.
# .env.local está ignorado por git: nunca lo commitees.

# Origen exacto del sitio, sin barra final. En desarrollo: http://localhost:3000
SITE_URL=http://localhost:3000

# Brevo (solo servidor). Para probar envíos reales en local, usa tu API key.
BREVO_API_KEY=

# Buzón del equipo y remitente verificado en Brevo.
CONTACT_TO_EMAIL=contacto.starkcore.solutions@gmail.com
CONTACT_FROM_EMAIL=contacto.starkcore.solutions@gmail.com

# Cloudflare Turnstile. Las claves de prueba oficiales siempre pasan.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
